# ---------------------------------------------------------------------------
# Supabase
#
# Project Settings → API. The anon key is safe in the browser: every query it
# makes is filtered by the RLS policies in supabase/migrations.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses RLS entirely — server-only, never prefixed with NEXT_PUBLIC_.
# Needed for two things: creating team accounts from the Users page, and
# writing the resume_file row when an upload completes (that callback has no
# user session, so there is no auth.uid() for a policy to check).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# UploadThing
#
# uploadthing.com → your app → API Keys. Server-only.
# ---------------------------------------------------------------------------
UPLOADTHING_TOKEN=your-uploadthing-token

# ---------------------------------------------------------------------------
# SSN encryption
#
# Symmetric key for pgp_sym_encrypt. Server-only, and deliberately NOT stored in
# the database — a dump of candidate_profile yields ciphertext without it.
#
# Generate one:  openssl rand -base64 32
#
# Losing this key means losing every stored SSN. Back it up wherever you keep
# other break-glass secrets. Rotating it requires decrypting with the old key
# and re-encrypting with the new one; there is no migration that does this for
# you.
# ---------------------------------------------------------------------------
APP_ENCRYPTION_KEY=
