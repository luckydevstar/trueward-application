# ---------------------------------------------------------------------------
# Supabase
#
# Project Settings → API. The anon key is safe in the browser: every query it
# makes is filtered by the RLS policies in supabase/migrations.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses RLS entirely — server-only, never prefixed with NEXT_PUBLIC_.
# Needed for two things: creating team accounts from the Users page, and
# writing the resume_file row when an upload completes (that callback has no
# user session, so there is no auth.uid() for a policy to check).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# UploadThing
#
# uploadthing.com → your app → API Keys. Server-only.
# ---------------------------------------------------------------------------
UPLOADTHING_TOKEN=your-uploadthing-token

# ---------------------------------------------------------------------------
# SSN encryption
#
# Symmetric key for pgp_sym_encrypt. Server-only, and deliberately NOT stored in
# the database — a dump of candidate_profile yields ciphertext without it.
#
# Generate one:  openssl rand -base64 32
#
# Losing this key means losing every stored SSN. Back it up wherever you keep
# other break-glass secrets. Rotating it requires decrypting with the old key
# and re-encrypting with the new one; there is no migration that does this for
# you.
# ---------------------------------------------------------------------------
APP_ENCRYPTION_KEY=

# Resume generation, through OpenRouter (https://openrouter.ai/keys).
# Server-only — no NEXT_PUBLIC_ prefix. Without it the builder's Generate
# button is off; everything else works. The model and system prompt are set
# in the app, on the super admin's Generation page.
OPENROUTER_API_KEY=
# Generations allowed per person per hour (a guard against runaway spend).
GENERATION_HOURLY_LIMIT=60

# ---------------------------------------------------------------------------
# Device gate (src/lib/gate.ts) — only approved browsers reach this site.
# Devices are approved in the Trueward Auth console (auth.trueward.guru); its
# schema is trueward-auth/supabase/schema.sql. Off unless GATE_ENABLED=true.
# ---------------------------------------------------------------------------
GATE_ENABLED=false
# This site's key in the console's site list.
GATE_APP_KEY=application
# Shared by every Trueward site, so one device id covers them all.
GATE_COOKIE_DOMAIN=.trueward.guru
# Signs the one-minute "allowed" pass. Any long random string, e.g. the output
# of `openssl rand -base64 32`. Without it every request is checked.
GATE_SECRET=
# Optional: shown on the access page as who to contact.
NEXT_PUBLIC_GATE_CONTACT=
